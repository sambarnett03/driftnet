{
    "[python]": {
        // Tells VS Code to use Ruff for formatting (fixing blank lines, spaces, etc.)
        "editor.defaultFormatter": "charliermarsh.ruff",
        // Automatically formats the file every time you press save
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            // Automatically fixes lint errors (like removing unused imports) on save
            "source.fixAll.ruff": "explicit",
            // Automatically sorts your imports (handles the "I" rule in your toml) on save
            "source.organizeImports.ruff": "explicit"
        }
    },
    // Ensures the Ruff extension is active for linting feedback while you type
    "ruff.enable": true,

    // Recommended extras for your ocean modeling package:
    "python.analysis.typeCheckingMode": "strict",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false
}